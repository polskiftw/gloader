<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DefineConstants>GLOADER;GLOADER_CLIENT</DefineConstants>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../gmods/AuthenticRaces/port/**/*.cs" LinkBase="AuthenticRaces" />
    <Compile Include="TerrariaStubs.cs" />
    <Compile Include="Program.cs" />
    <Content Include="../../gmods/AuthenticRaces/source/Assets/Textures/Players/Races/Skeleton/Male/ColorSkin/Body.png"
             Link="source/Assets/Textures/Players/Races/Skeleton/Male/ColorSkin/Body.png"
             CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <Target Name="RunAuthenticRacesClientRegression" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="&quot;$(TargetPath)&quot;" />
  </Target>
</Project>
