<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TEditRoot Condition="'$(TEditRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\external\TEdit</TEditRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5.1" />
    <ProjectReference Include="$(TEditRoot)\src\TEdit.Common\TEdit.Common.csproj" />
    <ProjectReference Include="$(TEditRoot)\src\TEdit.Png\TEdit.Png.csproj" />
    <ProjectReference Include="$(TEditRoot)\src\TEdit.Terraria\TEdit.Terraria.csproj" />
  </ItemGroup>
</Project>
