<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>GLoader</AssemblyName>
    <RootNamespace>GLoader</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <Version>0.3.0-alpha</Version>
    <InformationalVersion>0.3.0-alpha</InformationalVersion>
    <Company>gloader</Company>
    <Product>gloader</Product>
    <Description>Native Linux/Mono raw C# source mod loader for Terraria</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Microsoft.Net.Compilers.Toolset"
                      Version="4.8.0"
                      PrivateAssets="All"
                      GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies"
                      Version="1.0.3"
                      PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(PkgMicrosoft_Net_Compilers_Toolset)/tasks/net472/Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(PkgMicrosoft_Net_Compilers_Toolset)/tasks/net472/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Buffers">
      <HintPath>$(PkgMicrosoft_Net_Compilers_Toolset)/tasks/net472/System.Buffers.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Collections.Immutable">
      <HintPath>$(PkgMicrosoft_Net_Compilers_Toolset)/tasks/net472/System.Collections.Immutable.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Memory">
      <HintPath>$(PkgMicrosoft_Net_Compilers_Toolset)/tasks/net472/System.Memory.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Numerics.Vectors">
      <HintPath>$(PkgMicrosoft_Net_Compilers_Toolset)/tasks/net472/System.Numerics.Vectors.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Reflection.Metadata">
      <HintPath>$(PkgMicrosoft_Net_Compilers_Toolset)/tasks/net472/System.Reflection.Metadata.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>$(PkgMicrosoft_Net_Compilers_Toolset)/tasks/net472/System.Runtime.CompilerServices.Unsafe.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Text.Encoding.CodePages">
      <HintPath>$(PkgMicrosoft_Net_Compilers_Toolset)/tasks/net472/System.Text.Encoding.CodePages.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Threading.Tasks.Extensions">
      <HintPath>$(PkgMicrosoft_Net_Compilers_Toolset)/tasks/net472/System.Threading.Tasks.Extensions.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
